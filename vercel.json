{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "node_modules/tiny-secp256k1/lib/*.wasm"
    },
    "server.js": {
      "includeFiles": "node_modules/tiny-secp256k1/lib/*.wasm"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ]
}