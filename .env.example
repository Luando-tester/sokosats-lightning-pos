PORT=3000
# Mạng Bitcoin sử dụng cho ví non-custodial on-chain backup: testnet | bitcoin
BITCOIN_NETWORK=testnet

# Tùy chọn: Mnemonic 12 từ cho ví BIP84 của merchant (để trống server sẽ tự sinh ví mới khi khởi động)
MERCHANT_MNEMONIC=

# Lightning Address thật của merchant (LNURL-pay chuẩn LUD-06/LUD-16, ví dụ: satoshi@getalby.com)
# Có thể ghi đè trực tiếp ngay trên giao diện POS của merchant
DEFAULT_LIGHTNING_ADDRESS=hello@getalby.com

# Gemini API Key (miễn phí) để phân tích giọng nói/tin nhắn đơn hàng tiếng Pháp/Anh/Wolof sang hóa đơn sats
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Địa chỉ BTC nhận giải hackathon (CHƯA ĐIỀN - Muse sẽ hỏi Luân khi nộp bài)
HACKATHON_PAYOUT_BTC_ADDRESS=TBD